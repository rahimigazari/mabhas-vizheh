import random

secret_number = random.randint(1, 100)
attempts = 0

while attempts < 10:
    guess = int(input("Guess the number (1-100): "))
    attempts += 1

    if guess == secret_number:
        print("You win!")
        break
    elif guess < secret_number:
        print("Higher")
    else:
        print("Lower")
else:
    print("You lose! The number was:", secret_number)
